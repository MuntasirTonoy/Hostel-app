# ---------------------------------------------------------------
# Hostel Meal Management — environment variables
# Copy this file to .env (or .env.local) and fill in the values.
# Never commit the real file.
# ---------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or local).
# Do not put the database name in the URI; it is set below.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Database that holds every collection (admins, hostels, members, monthlyaccounts).
# Optional — defaults to "hostel".
MONGO_DB_NAME=hostel

# Auth.js secret used to encrypt session cookies.
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Public domain of the site, used for shareable report links
# (e.g. https://hisab.in/monthly-bill/k7x2p9). No trailing slash.
APP_URL=http://localhost:3000

# Optional: Google sign-in (OAuth). The "Continue with Google" button appears only
# when both are set. Create an OAuth client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   <APP_URL>/api/auth/callback/google   (e.g. http://localhost:3000/api/auth/callback/google)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional: Auth.js base URL (recommended in production behind a proxy).
# AUTH_URL=https://your-domain.com

# Optional: DNS servers used only as a fallback when the system resolver refuses
# MongoDB SRV lookups (common on Windows). Default: 8.8.8.8,1.1.1.1
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
